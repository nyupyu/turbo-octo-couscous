# Database URLs
AUTH_DATABASE_URL=postgresql://authuser:authpass@auth-db:5432/authdb
CRUD_DATABASE_URL=postgresql://cruduser:crudpass@crud-db:5432/cruddb
LOGS_DATABASE_URL=postgresql://logsuser:logspass@logs-db:5432/logsdb

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service URLs (internal Docker network)
AUTH_SERVICE_URL=http://auth-service:3001
CRUD_SERVICE_URL=http://crud-service:3002
LOGS_SERVICE_URL=http://logs-service:3003

# API Gateway
API_GATEWAY_PORT=3000
CLIENT_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3000/api

# Node Environment
NODE_ENV=production
